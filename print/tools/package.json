{
  "name": "mikeys-print-tools",
  "private": true,
  "description": "Renders print pieces (door hangers, EDDM postcard, yard sign, business card, gift card, car window decal, air freshener). Not part of the website build.",
  "scripts": {
    "hanger": "node build-door-hanger.cjs",
    "postcard": "node build-postcard.cjs",
    "shared": "node build-shared-postcard.cjs",
    "sign": "node build-yard-sign.cjs",
    "card": "node build-business-card.cjs",
    "gift": "node build-gift-card.cjs",
    "spots": "python3 sign-spots.py",
    "decal": "node build-car-decal.cjs",
    "side-decal": "node build-side-decal.cjs",
    "freshener": "node build-air-freshener.cjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/racing-sans-one": "^5.3.0",
    "jsqr": "^1.4.0",
    "playwright": "1.56.1",
    "potrace": "^2.1.8",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.0"
  }
}
