{
  "name": "mikeys-print-tools",
  "private": true,
  "description": "Renders print pieces (door hangers, EDDM postcard, yard sign, business card, gift card, car window decal, air freshener, Hometown Values magazine ad, Treat Street booth signs). Not part of the website build.",
  "scripts": {
    "hanger": "node build-door-hanger.cjs",
    "postcard": "node build-postcard.cjs",
    "shared": "node build-shared-postcard.cjs",
    "sign": "node build-yard-sign.cjs",
    "card": "node build-business-card.cjs",
    "gift": "node build-gift-card.cjs",
    "spots": "python3 sign-spots.py",
    "decal": "node build-car-decal.cjs",
    "side-decal": "node build-side-decal.cjs",
    "freshener": "node build-air-freshener.cjs",
    "htv": "node build-htv-ad.cjs",
    "htv-variations": "node build-htv-variations.cjs",
    "htv-concepts": "node build-htv-concepts.cjs",
    "htv-premium": "node build-htv-premium.cjs",
    "treat-signs": "node build-treat-street.cjs",
    "treat": "node build-treat-street-card.cjs",
    "treat-trifold": "node build-treat-street-trifold.cjs",
    "treat-stageit": "node build-treat-street-stageit.cjs",
    "treat-lego": "node build-treat-street-lego.cjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/racing-sans-one": "^5.3.0",
    "jsqr": "^1.4.0",
    "playwright": "1.56.1",
    "potrace": "^2.1.8",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.0"
  }
}
